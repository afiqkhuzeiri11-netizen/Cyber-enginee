-- FUNGSI MENCARI 1 TELUR TERDEKAT DI MAP
local function getNearestEgg(hrp)
    local nearestEgg = nil
    local shortestDist = math.huge
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj and (obj:IsA("Model") or obj:IsA("BasePart")) then
                local name = obj.Name:lower()
                -- Filter ketat agar tidak menyasar base/spawn sendiri
                if (name:find("egg") or name:find("telur") or name:find("nest")) and not name:find("player") then
                    local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                    if part and part.Position.Y > -50 then
                        local dist = (hrp.Position - part.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            nearestEgg = part
                        end
                    end
                end
            end
        end)
    end
    return nearestEgg
end

-- LOGIKA SMART FARM: AMBIL 1 TELUR -> BAWA KE BASE -> ULANGI
task.spawn(function()
    while task.wait(1.5) do -- Jeda aman agar anti-cheat tidak curiga
        pcall(function()
            if not isAutoEgg then return end
            local char = Player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            -- Gunakan posisi pemain saat ini sebagai base jika belum di-set manual
            local baseCFrame = customBasePos or hrp.CFrame

            -- 1. Cari 1 telur terdekat
            local targetEgg = getNearestEgg(hrp)
            if targetEgg and targetEgg.Parent then
                
                -- 2. Teleport ke telur dengan mulus
                hrp.CFrame = targetEgg.CFrame * CFrame.new(0, 3, 0)
                task.wait(0.4)

                -- 3. Eksekusi interaksi (Proximity / Touch)
                local prompt = targetEgg.Parent:FindFirstChildWhichIsA("ProximityPrompt", true) or targetEgg:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and fireproximityprompt then
                    fireproximityprompt(prompt)
                end
                
                if firetouchinterest then
                    firetouchinterest(hrp, targetEgg, 0)
                    task.wait(0.1)
                    firetouchinterest(hrp, targetEgg, 1)
                end
                
                task.wait(0.6) -- Jeda jeda agar status kepemilikan telur masuk

                -- 4. Bawa pulang ke Safe Zone / Base agar aman dari player lain & sistem kick
                hrp.CFrame = baseCFrame
                task.wait(1.0) -- Tunggu proses selesai sebelum cari telur berikutnya
            end
        end)
    end
end)


-- FUNGSI VALIDASI TELUR DENGAN FILTER EKSKLUSI BASE / SAFE ZONE
local function getValidMapEggs(hrp)
    local eggs = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj and (obj:IsA("Model") or obj:IsA("BasePart")) then
                local name = obj.Name:lower()
                
                if (name:find("egg") or name:find("telur") or name:find("nest")) 
                   and not name:find("player") 
                   and not name:find("character") 
                   and not name:find("base") 
                   and not name:find("spawn") 
                   and not name:find("ui") 
                   and not name:find("plot") then
                    
                    local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                    if part and part:IsA("BasePart") and part.Position.Y > -30 and part.Transparency < 1 then
                        
                        local isInsideBase = false
                        if customBasePos then
                            local distToBase = (part.Position - customBasePos.Position).Magnitude
                            if distToBase < 35 then
                                isInsideBase = true
                            end
                        end
                        
                        if not isInsideBase then
                            table.insert(eggs, {Model = obj, Part = part})
                        end
                    end
                end
            end
        end)
    end
    return eggs
end

-- LOGIKA FARMING UTAMA
task.spawn(function()
    while task.wait(1.2) do
        pcall(function()
            if not isAutoEgg then return end
            local char = Player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local baseCFrame = customBasePos or hrp.CFrame
            local eggs = getValidMapEggs(hrp)

            local targetEggData = nil
            local shortestDist = math.huge

            for _, eggData in ipairs(eggs) do
                local part = eggData.Part
                if part and (not farmedCache[part] or (tick() - farmedCache[part] > 8)) then
                    local dist = (hrp.Position - part.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        targetEggData = eggData
                    end
                end
            end

            if targetEggData then
                local part = targetEggData.Part
                local model = targetEggData.Model
                farmedCache[part] = tick()

                hrp.CFrame = part.CFrame * CFrame.new(0, 3, 0)
                task.wait(0.25)

                local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true) or part:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and fireproximityprompt then
                    fireproximityprompt(prompt)
                end

                for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") then
                        local rName = remote.Name:lower()
                        if rName:find("egg") or rName:find("pickup") or rName:find("collect") or rName:find("claim") then
                            pcall(function()
                                remote:FireServer(model)
                                remote:FireServer(part)
                            end)
                        end
                    end
                end

                if firetouchinterest then
                    firetouchinterest(hrp, part, 0)
                    task.wait(0.05)
                    firetouchinterest(hrp, part, 1)
                end

                task.wait(0.4)

                if customBasePos then
                    hrp.CFrame = baseCFrame
                    task.wait(0.8)
                end
            end
        end)
    end
end)

RunService.Heartbeat:Connect(function()
    pcall(function()
        local char = Player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = walkSpeedVal
            if isGodMode then hum.Health = hum.MaxHealth end
        end
    end)
end)


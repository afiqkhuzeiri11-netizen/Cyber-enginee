-- FUNGSI BLOKIR WILAYAH SAFE ZONE & PLOT SECARA TOTAL
local function isInsideRestrictedZone(pos)
    if customBasePos then
        if (pos - customBasePos.Position).Magnitude < 85 then
            return true
        end
    end

    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj and (obj:IsA("BasePart") or obj:IsA("Model")) then
                local name = obj.Name:lower()
                if name:find("safe") or name:find("zone") or name:find("plot") or name:find("base") or name:find("spawn") then
                    local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                    if part and part:IsA("BasePart") then
                        if (pos - part.Position).Magnitude < 60 then
                            return true
                        end
                    end
                end
            end
        end)
    end
    return false
end


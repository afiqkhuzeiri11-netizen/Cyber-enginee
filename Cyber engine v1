    pcall(function()
        local char = Player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = walkSpeedVal
            if isGodMode then hum.Health = hum.MaxHealth end
        end
    end)
end)


-- [[ CYBER ENGINE V6.3 - DIRECT EXECUTE FIXED ]] --

local success, Rayfield = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)

if not success or not Rayfield then
    Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Rayfield/main/source'))()
end

local Window = Rayfield:CreateWindow({
   Name = "⚡ Cyber Engine V6.3 // Direct GUI",
   LoadingTitle = "Memuat Antarmuka Langsung...",
   LoadingSubtitle = "by Cyber Engine",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false, 
})

local MainTab = Window:CreateTab("🥚 Precision Farm", 4483362458)
local PlayerTab = Window:CreateTab("🚀 Base & Settings", 4483362458)

local isAutoEgg = false
local isGodMode = false
local walkSpeedVal = 16
local customBasePos = nil
local farmedCache = {}

MainTab:CreateToggle({
   Name = "🥚 Auto Farm Eggs (Murni Telur Map Saja)",
   CurrentValue = false,
   Callback = function(Value)
      isAutoEgg = Value
   end,
})

PlayerTab:CreateButton({
   Name = "📍 Set Posisi Base / Safe Zone (Wajib Diset)",
   Callback = function()
      pcall(function()
         local char = game:GetService("Players").LocalPlayer.Character
         if char and char:FindFirstChild("HumanoidRootPart") then
            customBasePos = char.HumanoidRootPart.CFrame
            Rayfield:Notify({ Title = "Base Disimpan!", Content = "Area base dikecualikan dari farm.", Duration = 3 })
         end
      end)
   end,
})

PlayerTab:CreateToggle({
   Name = "🛡️ God Mode",
   CurrentValue = false,
   Callback = function(Value)
      isGodMode = Value
   end,
})

PlayerTab:CreateInput({
   Name = "WalkSpeed",
   PlaceholderText = "16",
   NumbersOnly = true,
   Callback = function(Text)
      local v = tonumber(Text)
      if v then walkSpeedVal = v end
   end,
})

-- LOGIKA FARMING UTAMA
task.spawn(function()
    while task.wait(1.2) do
        pcall(function()
            if not isAutoEgg then return end
            local player = game:GetService("Players").LocalPlayer
            local char = player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local baseCFrame = customBasePos or hrp.CFrame
            local workspace = game:GetService("Workspace")

            for _, obj in pairs(workspace:GetDescendants()) do
                if not isAutoEgg then break end
                pcall(function()
                    if obj and (obj:IsA("Model") or obj:IsA("BasePart")) then
                        local name = obj.Name:lower()
                        if (name:find("egg") or name:find("telur") or name:find("nest")) 
                           and not name:find("player") and not name:find("character") 
                           and not name:find("base") and not name:find("spawn") and not name:find("plot") then
                            
                            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            if part and part:IsA("BasePart") and part.Position.Y > -30 then
                                
                                local isInsideBase = false
                                if customBasePos then
                                    if (part.Position - customBasePos.Position).Magnitude < 35 then
                                        isInsideBase = true
                                    end
                                end

                                if not isInsideBase and (not farmedCache[part] or (tick() - farmedCache[part] > 8)) then
                                    farmedCache[part] = tick()

                                    hrp.CFrame = part.CFrame * CFrame.new(0, 3, 0)
                                    task.wait(0.25)

                                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) or part:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt and fireproximityprompt then
                                        fireproximityprompt(prompt)
                                    end

                                    for _, remote in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                                        if remote:IsA("RemoteEvent") then
                                            local rName = remote.Name:lower()
                                            if rName:find("egg") or rName:find("pickup") or rName:find("collect") then
                                                pcall(function() remote:FireServer(obj) remote:FireServer(part) end)
                                            end
                                        end
                                    end

                                    if firetouchinterest then
                                        firetouchinterest(hrp, part, 0)
                                        task.wait(0.05)
                                        firetouchinterest(hrp, part, 1)
                                    end

                                    task.wait(0.4)
                                    if customBasePos then
                                        hrp.CFrame = baseCFrame
                                        task.wait(0.8)
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end)
    end
end)

game:GetService("RunService").Heartbeat:Connect(function()
    pcall(function()
        local char = game:GetService("Players").LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = walkSpeedVal end
    end)
end)

Rayfield:Notify({
   Title = "Cyber Engine V6.3 Aktif",
   Content = "GUI Langsung Berhasil Dimuat!",
   Duration = 5,
   Image = 4483362458,
})

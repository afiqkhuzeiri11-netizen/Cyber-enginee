-- FUNGSI FILTER WILAYAH: MENGABAIKAN SELURUH AREA SAFE ZONE, PLOT, DAN BASE
local function isInsideSafeOrPlot(pos)
    -- 1. Jika posisi terlalu dekat dengan titik base yang disimpan (Radius 70 stud mencakup seluruh area base & safe zone di sekitar plot)
    if customBasePos then
        local distToBase = (pos - customBasePos.Position).Magnitude
        if distToBase < 75 then
            return true
        end
    end

    -- 2. Deteksi otomatis semua objek yang ada kata "safe", "zone", "plot", "base", "spawn" di workspace
    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj and (obj:IsA("BasePart") or obj:IsA("Model")) then
                local name = obj.Name:lower()
                if name:find("safe") or name:find("zone") or name:find("plot") or name:find("base") or name:find("spawn") then
                    local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                    if part and part:IsA("BasePart") then
                        local dist = (pos - part.Position).Magnitude
                        -- Jika posisi telur berada di dalam area part tersebut atau dekat sekali
                        if dist < 50 then
                            return true
                        end
                    end
                end
            end
        end)
    end

    return false
end

-- LOGIKA FARMING UTAMA: FARM DI LUAR -> AMBIL -> TELEPORT BALIK KE BASE
task.spawn(function()
    while task.wait(1.2) do
        pcall(function()
            if not isAutoEgg then return end
            local char = Player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local baseCFrame = customBasePos or hrp.CFrame

            for _, obj in pairs(Workspace:GetDescendants()) do
                if not isAutoEgg then break end
                pcall(function()
                    if obj and (obj:IsA("Model") or obj:IsA("BasePart")) then
                        local name = obj.Name:lower()
                        
                        -- Pastikan hanya mengambil telur murni di luar area safe zone/plot
                        if (name:find("egg") or name:find("telur") or name:find("nest")) 
                           and not name:find("player") 
                           and not name:find("character") 
                           and not name:find("base") 
                           and not name:find("spawn") 
                           and not name:find("plot") 
                           and not name:find("ui") then
                            
                            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            if part and part:IsA("BasePart") and part.Position.Y > -30 then
                                
                                -- CEK APAKAH TELUR ADA DI DALAM SAFE ZONE / PLOT
                                local restricted = isInsideSafeOrPlot(part.Position)

                                if not restricted and (not farmedCache[part] or (tick() - farmedCache[part] > 8)) then
                                    farmedCache[part] = tick()

                                    -- 1. Teleport ke telur di luar safe zone
                                    hrp.CFrame = part.CFrame * CFrame.new(0, 3, 0)
                                    task.wait(0.3)

                                    -- 2. Trigger ProximityPrompt
                                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) or part:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt and fireproximityprompt then
                                        fireproximityprompt(prompt)
                                    end

                                    -- 3. Trigger RemoteEvent pickup
                                    for _, remote in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                                        if remote:IsA("RemoteEvent") then
                                            local rName = remote.Name:lower()
                                            if rName:find("egg") or rName:find("pickup") or rName:find("collect") then
                                                pcall(function() 
                                                    remote:FireServer(obj) 
                                                    remote:FireServer(part) 
                                                end)
                                            end
                                        end
                                    end

                                    -- 4. Simulasi touch interest
                                    if firetouchinterest then
                                        firetouchinterest(hrp, part, 0)
                                        task.wait(0.05)
                                        firetouchinterest(hrp, part, 1)
                                    end

                                    task.wait(0.4)

                                    -- 5. WAJIB TELEPORT BALIK KE BASE SETELAH AMBIL TELUR
                                    hrp.CFrame = baseCFrame
                                    task.wait(0.8)
                                end
                            end
                        end
                    end
                end)
            end
        end)
    end
end)


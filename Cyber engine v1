-- FUNGSI VALIDASI WILAYAH (Mendeteksi apakah posisi telur berada di dalam wilayah base/plot/safezone)
local function isInsideRestrictedZone(pos)
    -- 1. Cek berdasarkan posisi base yang di-set manual (Radius diperlebar jadi 60 stud untuk mencakup satu wilayah plot)
    if customBasePos then
        local dist = (pos - customBasePos.Position).Magnitude
        if dist < 65 then
            return true
        end
    end

    -- 2. Cek otomatis berdasarkan objek wilayah base/plot/safezone di Workspace
    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj and obj:IsA("BasePart") then
                local name = obj.Name:lower()
                if name:find("plot") or name:find("base") or name:find("safezone") or name:find("spawn") then
                    local distToZone = (pos - obj.Position).Magnitude
                    -- Jika posisi telur sangat dekat dengan part base/plot, anggap sebagai area terlarang
                    if distToZone < 40 and obj.Size.Magnitude > 10 then
                        return true
                    end
                end
            end
        end)
    end
    
    return false
end

-- LOGIKA FARMING UTAMA DENGAN FILTER WILAYAH
task.spawn(function()
    while task.wait(1.2) do
        pcall(function()
            if not isAutoEgg then return end
            local char = Player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local baseCFrame = customBasePos or hrp.CFrame

            for _, obj in pairs(Workspace:GetDescendants()) do
                if not isAutoEgg then break end
                pcall(function()
                    if obj and (obj:IsA("Model") or obj:IsA("BasePart")) then
                        local name = obj.Name:lower()
                        
                        -- Hanya ambil objek yang benar-benar bernama egg/telur/nest di luar wilayah terlarang
                        if (name:find("egg") or name:find("telur") or name:find("nest")) 
                           and not name:find("player") 
                           and not name:find("character") 
                           and not name:find("base") 
                           and not name:find("spawn") 
                           and not name:find("plot") 
                           and not name:find("ui") then
                            
                            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            if part and part:IsA("BasePart") and part.Position.Y > -30 then
                                
                                -- Panggil fungsi cek wilayah terlarang
                                local restricted = isInsideRestrictedZone(part.Position)

                                if not restricted and (not farmedCache[part] or (tick() - farmedCache[part] > 8)) then
                                    farmedCache[part] = tick()

                                    -- 1. Teleport ke telur di luar wilayah base
                                    hrp.CFrame = part.CFrame * CFrame.new(0, 3, 0)
                                    task.wait(0.25)

                                    -- 2. Jalankan ProximityPrompt
                                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) or part:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt and fireproximityprompt then
                                        fireproximityprompt(prompt)
                                    end

                                    -- 3. Trigger RemoteEvent pickup
                                    for _, remote in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                                        if remote:IsA("RemoteEvent") then
                                            local rName = remote.Name:lower()
                                            if rName:find("egg") or rName:find("pickup") or rName:find("collect") then
                                                pcall(function() 
                                                    remote:FireServer(obj) 
                                                    remote:FireServer(part) 
                                                end)
                                            end
                                        end
                                    end

                                    -- 4. Touch interest
                                    if firetouchinterest then
                                        firetouchinterest(hrp, part, 0)
                                        task.wait(0.05)
                                        firetouchinterest(hrp, part, 1)
                                    end

                                    task.wait(0.4)

                                    -- 5. Bawa pulang ke base
                                    if customBasePos then
                                        hrp.CFrame = baseCFrame
                                        task.wait(0.8)
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end)
    end
end)


-- [ FUNGSI MENCARI TELUR ASLI DI MAP (Bukan Base) ] --
local function getRealEggs()
    local eggs = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            -- Pastikan objek adalah Model/Part telur dan BUKAN bagian dari player/base
            if obj and (obj:IsA("Model") or obj:IsA("BasePart")) then
                local name = obj.Name:lower()
                -- Filter ketat agar hanya mengambil objek telur liar/map
                if (name:find("egg") or name:find("telur") or name:find("nest")) and not name:find("base") and not name:find("spawn") and not name:find("player") then
                    local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                    if part and part.Position.Y > -50 then -- Pastikan berada di dalam map
                        table.insert(eggs, part)
                    end
                end
            end
        end)
    end
    return eggs
end

-- [ LOOP AUTO FARM PRESISI TINGGI ] --
task.spawn(function()
    while task.wait(1.2) do
        pcall(function()
            if not isAutoEgg then return end
            local char = Player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local validEggs = getRealEggs()
            for _, eggPart in ipairs(validEggs) do
                if not isAutoEgg then break end
                pcall(function()
                    if eggPart and eggPart.Parent and (not farmedCache[eggPart] or (tick() - farmedCache[eggPart] > 6)) then
                        farmedCache[eggPart] = tick()
                        
                        -- Langsung teleport pas di atas telur asli
                        hrp.CFrame = eggPart.CFrame * CFrame.new(0, 3, 0)
                        task.wait(0.2)

                        -- Cari dan Eksekusi Prompt
                        local prompt = eggPart.Parent:FindFirstChildWhichIsA("ProximityPrompt", true) or eggPart:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt and fireproximityprompt then
                            fireproximityprompt(prompt)
                        end
                        
                        -- Simulasi sentuhan jika butuh touch interest
                        if firetouchinterest then
                            firetouchinterest(hrp, eggPart, 0)
                            task.task = task.wait(0.05)
                            firetouchinterest(hrp, eggPart, 1)
                        end
                        task.wait(0.3)
                    end
                end)
            end
        end)
    end
end)

-- [ ESP VISUAL GARIS KE TELUR ] --
RunService.RenderStepped:Connect(function()
    pcall(function()
        if not isESPActive then return end
        local validEggs = getRealEggs()
        for _, eggPart in ipairs(validEggs) do
            if eggPart then
                local billboard = eggPart:FindFirstChild("CyberESP")
                if not billboard then
                    billboard = Instance.new("BillboardGui")
                    billboard.Name = "CyberESP"
                    billboard.Size = UDim2.new(0, 100, 0, 50)
                    billboard.AlwaysOnTop = true
                    billboard.Adornee = eggPart
                    
                    local textLabel = Instance.new("TextLabel", billboard)
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.Text = "🥚 [TELUR ASLI]"
                    textLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
                    textLabel.TextScaled = true
                    textLabel.Font = Enum.Font.SourceSansBold
                    
                    billboard.Parent = eggPart
                end
            end
        end
    end)
end)

